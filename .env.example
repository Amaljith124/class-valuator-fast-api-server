APP_NAME=Humaniti Video Analysis
APP_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/dbname
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=class-recordings
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_REGION=auto
GEMINI_API_KEY=api-key-for-gemini
GEMINI_MODEL=gemini-3.5-flash
INTERNAL_API_TOKEN=must-match-node-server
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CONCURRENCY=1
WHISPER_BATCH_SIZE=8
WHISPER_BEAM_SIZE=1
WHISPER_LANGUAGE=
WHISPER_CANDIDATE_LANGUAGES=en,ml,hi,ta
WHISPER_CPU_THREADS=0
LLM_BATCH_SIZE=120
LLM_CONCURRENCY=3
GEMINI_TIMEOUT_MS=120000
TRANSCRIPT_CHECKPOINT_ENABLED=true
TEMP_DIR=./tmp
MAX_VIDEO_FRAMES=12
FRAME_INTERVAL_SECONDS=30
MAX_MEDIA_MB=500
